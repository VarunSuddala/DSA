    def firstBadVersion(self, n: int) -> int:
        l=1
        r=n
        res=-1
        while l<=r:
            mid= l+(r-l)//2

            if isBadVersion(mid):
                res=mid
                r=mid-1
            else:
                l=mid+1
        return res
